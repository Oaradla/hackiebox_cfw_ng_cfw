diff --git a/sd-bootloader-ng/bootmanager/bootstate.c b/sd-bootloader-ng/bootmanager/bootstate.c
new file mode 100644
index 0000000..72dba42
--- /dev/null
+++ b/sd-bootloader-ng/bootmanager/bootstate.c
@@ -0,0 +1,133 @@
+//Boot state file and handover record, see bootstate.h.
+#include <string.h>
+#include "bootstate.h"
+#include "ff.h"
+#include "diskio.h"
+#include "logger.h"
+
+#define STATE_MAGIC 0x3153474Eu   //"NGS1"
+#define HANDOVER_MAGIC 0x3148474Eu //"NGH1"
+#define HANDOVER_ADDR 0x20003FE0u
+
+//CRC-32 as in Ogg: polynomial 0x04C11DB7, init 0, not reflected.
+static uint32_t crc32Ogg(const uint8_t* data, uint32_t len) {
+  uint32_t crc = 0;
+  while (len--) {
+    crc ^= (uint32_t)*data++ << 24;
+    for (uint8_t i = 0; i < 8; i++)
+      crc = (crc & 0x80000000u) ? (crc << 1) ^ 0x04C11DB7u : crc << 1;
+  }
+  return crc;
+}
+
+static uint32_t getLe32(const uint8_t* p) {
+  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static void putLe32(uint8_t* p, uint32_t v) {
+  p[0] = (uint8_t)v;
+  p[1] = (uint8_t)(v >> 8);
+  p[2] = (uint8_t)(v >> 16);
+  p[3] = (uint8_t)(v >> 24);
+}
+
+static bool slotValid(uint8_t slot) {
+  return slot <= 8 || slot == BOOTSTATE_SLOT_NONE;
+}
+
+bool BootState_Read(const char* path, sBootState* state) {
+  FIL file;
+  uint8_t raw[32];
+  UINT read = 0;
+
+  if (path == NULL || path[0] == '\0')
+    return false;
+  if (f_open(&file, path, FA_READ) != FR_OK)
+    return false;
+  bool ok = f_size(&file) == sizeof(raw) && f_read(&file, raw, sizeof(raw), &read) == FR_OK && read == sizeof(raw);
+  f_close(&file);
+  if (!ok)
+    return false;
+  if (getLe32(raw) != STATE_MAGIC || getLe32(raw + 28) != crc32Ogg(raw, 28)) {
+    Logger_error("Boot state file %s invalid", path);
+    return false;
+  }
+  state->activeSlot = raw[4];
+  state->nextSlot = raw[5];
+  state->nextKind = raw[6];
+  state->tries = raw[7];
+  state->helperTask = raw[8];
+  state->lastResult = raw[9];
+  state->helperSlot = raw[10];
+  state->rolledBackBuild = getLe32(raw + 12);
+  if (!slotValid(state->activeSlot) || !slotValid(state->nextSlot) || !slotValid(state->helperSlot)) {
+    Logger_error("Boot state file %s has an invalid slot", path);
+    return false;
+  }
+  return true;
+}
+
+bool BootState_Write(const char* path, const sBootState* state) {
+  FIL file;
+  uint8_t raw[32];
+  UINT read = 0;
+
+  //The file system is read-only here: the file, created by the firmware,
+  //is rewritten in place, its first sector written directly.
+  if (f_open(&file, path, FA_READ) != FR_OK)
+    return false;
+  bool ok = f_size(&file) == sizeof(raw) && f_read(&file, raw, sizeof(raw), &read) == FR_OK
+            && read == sizeof(raw) && file.sect != 0;
+  if (ok) {
+    FATFS* fs = file.obj.fs;
+    //With _FS_TINY the sector of the file data is in fs->win now.
+    ok = fs->winsect == file.sect;
+    if (ok) {
+      memset(fs->win, 0, 32);
+      putLe32(fs->win, STATE_MAGIC);
+      fs->win[4] = state->activeSlot;
+      fs->win[5] = state->nextSlot;
+      fs->win[6] = state->nextKind;
+      fs->win[7] = state->tries;
+      fs->win[8] = state->helperTask;
+      fs->win[9] = state->lastResult;
+      fs->win[10] = state->helperSlot;
+      putLe32(fs->win + 12, state->rolledBackBuild);
+      putLe32(fs->win + 28, crc32Ogg(fs->win, 28));
+      ok = disk_write(fs->drv, fs->win, file.sect, 1) == RES_OK;
+    }
+  }
+  f_close(&file);
+  if (!ok)
+    Logger_error("Writing boot state file %s failed", path);
+  return ok;
+}
+
+uint32_t BootState_ImageBuild(const char* imagePath) {
+  FIL file;
+  uint8_t bb[112];
+  UINT read = 0;
+  uint32_t build = 0;
+
+  if (f_open(&file, imagePath, FA_READ) != FR_OK)
+    return 0;
+  uint32_t size = f_size(&file);
+  if (size >= 176 && f_lseek(&file, size - 176) == FR_OK
+      && f_read(&file, bb, sizeof(bb), &read) == FR_OK && read == sizeof(bb)
+      && getLe32(bb) == 0xBEAC0005u && getLe32(bb + 108) == 0xBEAC0005u)
+    build = getLe32(bb + 8);
+  f_close(&file);
+  return build;
+}
+
+void BootState_WriteHandover(uint8_t slot, uint8_t kind, uint32_t bootloaderWord) {
+  uint8_t raw[32];
+
+  memset(raw, 0, sizeof(raw));
+  putLe32(raw, HANDOVER_MAGIC);
+  raw[4] = slot;
+  raw[5] = kind;
+  putLe32(raw + 8, bootloaderWord);
+  putLe32(raw + 28, crc32Ogg(raw, 28));
+  memcpy((void*)HANDOVER_ADDR, raw, sizeof(raw));
+}
diff --git a/sd-bootloader-ng/bootmanager/bootstate.h b/sd-bootloader-ng/bootmanager/bootstate.h
new file mode 100644
index 0000000..b827e2c
--- /dev/null
+++ b/sd-bootloader-ng/bootmanager/bootstate.h
@@ -0,0 +1,48 @@
+//Boot state file and handover record for trial starts, rollback and helper
+//images.
+#ifndef __BOOTSTATE_H__
+#define __BOOTSTATE_H__
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define BOOTSTATE_SLOT_NONE 0xFF
+
+enum BOOTSTATE_KIND {
+  BOOTSTATE_KIND_NONE = 0,
+  BOOTSTATE_KIND_TRIAL = 1,
+  BOOTSTATE_KIND_HELPER = 2,
+};
+
+enum BOOTSTATE_RESULT {
+  BOOTSTATE_RESULT_NONE = 0,
+  BOOTSTATE_RESULT_CONFIRMED = 1,
+  BOOTSTATE_RESULT_ROLLED_BACK = 2,
+  BOOTSTATE_RESULT_HELPER_DONE = 3,
+  BOOTSTATE_RESULT_HELPER_FAILED = 4,
+};
+
+typedef struct sBootState {
+  uint8_t activeSlot;
+  uint8_t nextSlot;
+  uint8_t nextKind;
+  uint8_t tries;
+  uint8_t helperTask;
+  uint8_t lastResult;
+  uint8_t helperSlot;
+  uint32_t rolledBackBuild;
+} sBootState;
+
+//Reads the state file named by "stateFile"; false when it is missing or
+//invalid.
+bool BootState_Read(const char* path, sBootState* state);
+bool BootState_Write(const char* path, const sBootState* state);
+
+//Build number (offset 8 of the build block) of a slot file; 0 if unreadable.
+uint32_t BootState_ImageBuild(const char* imagePath);
+
+//Writes the handover record at 0x20003FE0. Must be the last
+//memory write before the jump.
+void BootState_WriteHandover(uint8_t slot, uint8_t kind, uint32_t bootloaderWord);
+
+#endif
