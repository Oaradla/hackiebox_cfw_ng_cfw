+#ifndef FIXED_BOOT_IMAGE
+//Chooses the slot to start from the boot state file. Returns
+//true when a trial start or helper run was pending.
+static bool ApplyBootState(void) {
+  bool pending = false;
+
+  bootKind = BOOTSTATE_KIND_NONE;
+  jsonActiveImage = Config_generalSettings.activeImage;
+  bootStateValid = BootState_Read(Config_generalSettings.stateFile, &bootState);
+  if (!bootStateValid)
+    return false;
+
+  if (bootState.activeSlot != BOOTSTATE_SLOT_NONE)
+    Config_generalSettings.activeImage = bootState.activeSlot;
+
+  if (bootState.nextSlot != BOOTSTATE_SLOT_NONE) {
+    pending = true;
+    if (networkStartBrokeDown() && !isChargerConnected()) {
+      //an empty battery, not the image: the try is not counted
+      Logger_info("Slot %i broke down in its network start, trial stays pending", bootState.nextSlot);
+      bootState.tries = 0;
+      BootState_Write(Config_generalSettings.stateFile, &bootState);
+      MAP_PRCMOCRRegisterWrite(0, 0);
+      MAP_PRCMOCRRegisterWrite(1, 0);
+      batteryEmptyHibernate();
+    } else if (bootState.tries == 0 && Config_imageInfos[bootState.nextSlot].fileExists) {
+      Config_generalSettings.activeImage = bootState.nextSlot;
+      bootKind = bootState.nextKind;
+    } else {
+      FailedNextSlot();
+    }
+  }
+  return pending;
+}
+
+//Counts the start of the pending slot. Called after the last check that can
+//hibernate, so a start that never happened is not used up.
+static bool CountNextSlotTry(void) {
+  bootState.tries = 1;
+  if (!BootState_Write(Config_generalSettings.stateFile, &bootState))
+    return false;
+  Logger_info("Trial/helper start of slot %i, kind %i", bootState.nextSlot, bootState.nextKind);
+  return true;
+}
+
+//The pending slot did not confirm or could not be started: return to the
+//active slot. Returns false when nothing was pending.
+static bool FailedNextSlot(void) {
+  if (!bootStateValid || nextSlotDeferred || bootState.nextSlot == BOOTSTATE_SLOT_NONE)
+    return false;
+  Logger_warn("Slot %i not confirmed, back to the active slot", bootState.nextSlot);
+  if (bootState.nextKind == BOOTSTATE_KIND_TRIAL) {
+    bootState.lastResult = BOOTSTATE_RESULT_ROLLED_BACK;
+    bootState.rolledBackBuild = BootState_ImageBuild(GetImagePathById(bootState.nextSlot));
+  } else {
+    bootState.lastResult = BOOTSTATE_RESULT_HELPER_FAILED;
+  }
+  bootState.nextSlot = BOOTSTATE_SLOT_NONE;
+  bootState.nextKind = BOOTSTATE_KIND_NONE;
+  bootState.tries = 0;
+  BootState_Write(Config_generalSettings.stateFile, &bootState);
+  bootKind = BOOTSTATE_KIND_NONE;
+  Config_generalSettings.activeImage = bootState.activeSlot != BOOTSTATE_SLOT_NONE ? bootState.activeSlot : jsonActiveImage;
+  return true;
+}
